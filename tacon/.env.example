# tacon live e2e test config — copy this file to .env and fill in your token.
#
# These vars are ONLY consulted when you run tests with TACON_LIVE=1.
# They are NEVER read by the regular `tacon` CLI or by the unit test suite.
#
# Worked example — for a repo at:
#   https://github.com/Netdb-NCKU/pre-test-hw-Tzun27
# the values would be:
#   TACON_TEST_ORG=Netdb-NCKU                      (the part after github.com/)
#   TACON_TEST_ASSIGNMENT_PREFIX=pre-test-hw       (the assignment slug from
#                                                   the classroom URL; the
#                                                   per-student suffix is
#                                                   appended automatically by
#                                                   GitHub Classroom)
#   TACON_TEST_REPO=Netdb-NCKU/pre-test-hw-Tzun27  (optional — pin the
#                                                   write+rollback test to
#                                                   this exact repo)


# Required: a personal access token with `repo` scope.
# Generate at https://github.com/settings/tokens (classic) or
# https://github.com/settings/personal-access-tokens (fine-grained).
# Fine-grained: scope to ONLY the Netdb-NCKU org's pre-test-hw-* repos.
TACON_GITHUB_TOKEN=ghp_paste_your_token_here

# Required: the GitHub org that owns the test classroom repos.
# Example: Netdb-NCKU
# tacon's live tests REFUSE to operate on any repo not in this org.
TACON_TEST_ORG=Netdb-NCKU

# Required: the assignment slug. Live tests refuse to operate on any
# repo whose name doesn't contain this substring. For
# pre-test-hw-Tzun27, the assignment slug is "pre-test-hw".
TACON_TEST_ASSIGNMENT_PREFIX=pre-test-hw

# Optional: a single repo full name (owner/repo) to use for the
# write+rollback test. Leave blank to auto-pick the first repo whose
# name contains TACON_TEST_ASSIGNMENT_PREFIX. The test still
# enforces the scope guard before any write.
# Example: Netdb-NCKU/pre-test-hw-Tzun27
TACON_TEST_REPO=

# Opt-in flag. The live tests are skipped unless this is "1".
# We keep it separate from the rest so a stray `tacon` invocation
# can't accidentally trigger live tests.
TACON_LIVE=0
